{
  "name": "hotel-management",
  "version": "1.0.0",
  "private": true,
  "description": "Responsive hotel listing and management app",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "start": "node server/index.js --production"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@reduxjs/toolkit": "^2.9.0",
    "async-exit-hook": "^2.0.1",
    "dotenv": "^16.6.1",
    "embedded-postgres": "^17.9.0-beta.16",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "vite": "^6.4.1"
  }
}
